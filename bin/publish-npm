#!/usr/bin/env bash

set -euo pipefail

yarn build
cd dist

VERSION="$(jq -r -e '.version' ./package.json)"
TAG="latest"
# Prereleases keep their own channel, including the first published version.
if [[ "$VERSION" =~ -([a-zA-Z][a-zA-Z0-9]*) ]]; then
  TAG="${BASH_REMATCH[1]}"
fi

npm publish --tag "$TAG"
